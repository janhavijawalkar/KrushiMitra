# KrushiMitra Frontend Environment Configuration

# Backend API URL (leave blank in local dev to use Vite proxy /api)
# In production (e.g. Vercel), set this to your deployed backend URL:
# VITE_API_URL=https://krushimitra-backend.onrender.com

# Google OAuth 2.0 Client ID for Google Sign-In
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
