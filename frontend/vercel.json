{
  "headers": [
    {
      "source": "/downloads/(.*)\\.apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=KrushiMitra.apk"
        }
      ]
    },
    {
      "source": "/downloads/(.*)\\.exe",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/x-msdownload"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=KrushiMitra-Setup.exe"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
