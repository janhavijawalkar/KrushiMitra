# =================================================================
# KrushiMitra Backend Environment Configuration
# =================================================================

# Server Port (optional, defaults to 5000 locally or platform $PORT on Render/Railway)
# PORT=5000
# FLASK_DEBUG=false

# -----------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# -----------------------------------------------------------------
# Option A: Cloud Connection String (Recommended for Render, Railway, Aiven, TiDB Cloud)
# DATABASE_URL=mysql://username:password@host:port/database?ssl-mode=REQUIRED

# Option B: Individual MySQL Settings (Local XAMPP / MySQL Server)
DB_TYPE=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DB=krushimitra
# MYSQL_SSL=true

# Option C: Persistent SQLite Path (if using persistent volume disk)
# DB_TYPE=sqlite
# SQLITE_PATH=/var/data/krushimitra.db

# -----------------------------------------------------------------
# 2. EXTERNAL SERVICES & API KEYS
# -----------------------------------------------------------------
# OpenWeatherMap API Key (Free key from https://openweathermap.org/api)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Google Gemini API Key for Plant Doctor & Agronomy Chatbot (From https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# SMTP Email Configuration (For welcome emails and password resets via Gmail App Password)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=krushimitra.project1@gmail.com
SMTP_PASSWORD=your_gmail_app_password
